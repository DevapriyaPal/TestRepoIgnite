        <focus-ctd-trigger appliance="ALWAYS" is_or="false" name="test step-1" negative="false" suppressNewLine="false" triggerType="Test_Steps">
            <focus-ctd-multiple-template>
                <focus-ctd-multiple-template-testSteps>
                    <focus-ctd-template text="Create a purchase order in the system for an Egyptian supplier with a hard currency (EUR)."/>
                    <focus-ctd-template text="Receive an invoice from the supplier in EUR through the Edicom portal and verify it is processed in Basware."/>
                    <focus-ctd-template text="Ensure the invoice is posted in SAP with the correct document currency (EUR) and local currency (EGP) values."/>
                    <focus-ctd-template text="Verify that the payment currency is set to EGP and the payment amount is calculated correctly based on the invoice amount in EUR."/>
                    <focus-ctd-template text="Approve the payment proposal and execute the payment run."/>
                    <focus-ctd-template text="Validate that the payment file generated is in the correct format (MT101) and is accepted by the bank (Commercial International Bank)."/>
                    <focus-ctd-template text="Check that the supplier's account is cleared in EGP and there is no residual balance in the document currency (EUR)."/>
                    <focus-ctd-template text="Verify that the cash payment process for the supplier is handled correctly through the Fiori app and the cash journal is updated accordingly."/>
                    <focus-ctd-template text="ผู้ใช้ทางธุรกิจสร้างคำขอชำระเงินให้กับผู้ขาย/พนักงานในระบบ"/>
                    <focus-ctd-template text="ระบบส่งคำขอเพื่ออนุมัติตามลำดับชั้นที่กำหนด"/>
                    <focus-ctd-template text="หลังจากการอนุมัติแล้ว ผู้ใช้ทางธุรกิจขอเงินสดจากแคชเชียร์"/>
                    <focus-ctd-template text="แคชเชียร์จ่ายเงินสดและแจ้งให้ RTR บันทึกรายการเงินสด"/>
                    <focus-ctd-template text="RTR บันทึกรายการเงินสดในแอป Fiori โดยใช้บัญชีพักชำระเงิน"/>
                    <focus-ctd-template text="ทีมประมวลผลใบแจ้งหนี้ตรวจสอบยอดคงเหลือในบัญชีพักชำระหนี้กับใบแจ้งหนี้ที่ลงรายการไว้"/>
                    <focus-ctd-template text="ทีม PTP เคลียร์ยอดคงเหลือในบัญชีพักชำระหนี้กับใบแจ้งหนี้หรือเอกสารที่ไม่ใช่ใบแจ้งหนี้ (KA)"/>
                    <focus-ctd-template text="ใบแจ้งหนี้ถูกส่งมาจากผู้ขายเป็นสกุลเงิน EUR"/>
                    <focus-ctd-template text="ระบบลงรายการใบแจ้งหนี้ใน Basware และส่งไปยัง SAP"/>
                    <focus-ctd-template text="ใน SAP ระบบคัดลอกจำนวนเงินในสกุลเงินท้องถิ่นไปยังช่องจำนวนเงินการชำระเงิน"/>
                    <focus-ctd-template text="การชำระเงินถูกดำเนินการเป็นสกุลเงิน EGP"/>
                    <focus-ctd-template text="ยอดคงเหลือในบัญชีผู้ขายถูกเคลียร์โดยการลงรายการบัญชีใหม่ไปยังบัญชีทางเทคนิค"/>
                    <focus-ctd-template text="สร้างแบบฟอร์ม PO ในระบบ"/>
                    <focus-ctd-template text="ตรวจสอบว่าแบบฟอร์ม PO ถูกกำหนดค่าตามเทมเพลตที่กำหนดไว้"/>
                    <focus-ctd-template text="ตรวจสอบว่ารูปแบบอีเมลและ PDF ที่สร้างขึ้นถูกต้อง"/>
                    <focus-ctd-template text="สร้างใบแจ้งหนี้ที่มีภาษีสองประเภทที่แตกต่างกัน"/>
                    <focus-ctd-template text="ระบบลงรายการใบแจ้งหนี้ใน Basware และส่งไปยัง SAP"/>
                    <focus-ctd-template text="ตรวจสอบว่าข้อมูลภาษีถูกบันทึกอย่างถูกต้อง"/>
                    <focus-ctd-template text="สร้างไฟล์การชำระเงินสำหรับธนาคารต่างๆ (BNP, Citi Bank, Commercial International Bank, Credit Agricole, Emirates NBD, QNB)"/>
                    <focus-ctd-template text="ตรวจสอบว่าไฟล์การชำระเงินถูกสร้างขึ้นตามรูปแบบที่กำหนดไว้สำหรับแต่ละธนาคาร"/>
                </focus-ctd-multiple-template-testSteps>
                <focus-ctd-multiple-template-expectedResults>
                    <focus-ctd-template text="The invoice is successfully processed in Basware and posted in SAP with the correct currencies."/>
                    <focus-ctd-template text="The payment is executed in EGP, and the payment amount is correctly calculated."/>
                    <focus-ctd-template text="The payment file is generated in MT101 format and accepted by the Commercial International Bank."/>
                    <focus-ctd-template text="The supplier's account is cleared in EGP with no residual balance in EUR."/>
                    <focus-ctd-template text="The cash payment process is correctly handled through the Fiori app, and the cash journal is updated."/>
                    <focus-ctd-template text="## Refined Test Case"/>
                    <focus-ctd-template text="ใบแจ้งหนี้ถูกสร้างขึ้นจากพอร์ทัลรัฐบาลอียิปต์และถูกส่งไปยัง Basware ผ่าน Edicom โดยใช้การเชื่อมต่อ AS2"/>
                    <focus-ctd-template text="ใบแจ้งหนี้มีสกุลเงินเป็น USD และบัญชีธนาคารของผู้ขายเป็นสกุลเงินแข็ง"/>
                    <focus-ctd-template text="ระบบตรวจสอบสิทธิ์การรับชำระเงินเป็นสกุลเงินแข็งและพบว่าได้รับสิทธิ์จากรัฐบาล"/>
                    <focus-ctd-template text="ระบบจะคัดลอกจำนวนเงินในสกุลเงินท้องถิ่นไปยังช่องจำนวนเงินการชำระเงิน"/>
                    <focus-ctd-template text="การชำระเงินจะดำเนินการในสกุลเงินท้องถิ่น (EGP) และใช้บัญชีแยกประเภทเป้าหมายในการหักบัญชีใบแจ้งหนี้"/>
                    <focus-ctd-template text="ยอดคงเหลือในบัญชีผู้ขายจะถูกเคลียร์โดยการโพสต์ยอดคงเหลือใหม่ไปยังบัญชีทางเทคนิค"/>
                    <focus-ctd-template text="การขออนุมัติการชำระเงินด้วยเงินสดจะถูกสร้างขึ้นสำหรับพนักงานและได้รับการอนุมัติ"/>
                    <focus-ctd-template text="แคชเชียร์จ่ายเงินสดให้กับพนักงานและ RTR บันทึกรายการบันทึกบัญชีเงินสดโดยใช้แอป Fiori"/>
                    <focus-ctd-template text="รายการบันทึกบัญชีเงินสดจะถูกบันทึกไว้ในบัญชีพักชำระเงินเฉพาะ"/>
                    <focus-ctd-template text="ไฟล์บัญชี MXP จะถูกสร้างขึ้นและยอดคงเหลือในบัญชีพักชำระเงินจะถูกเคลียร์"/>
                    <focus-ctd-template text="การคืนเงินสดจะถูกดำเนินการและบันทึกรายการบันทึกบัญชีเงินสด (รายการรับเข้า) จะถูกสร้างขึ้น"/>
                    <focus-ctd-template text="แบบฟอร์ม PO จะถูกสร้างขึ้นตามเทมเพลตที่กำหนดไว้ในไฟล์กำหนดค่า SAP CORE และสร้างอีเมลและ PDF ในรูปแบบที่ถูกต้อง"/>
                    <focus-ctd-template text="ใบแจ้งหนี้ที่มีภาษีสองประเภทที่แตกต่างกันจะถูกสร้างขึ้นและฟิลด์ภาษีหลายรายการจะถูกเพิ่มใน Basware/SAP"/>
                    <focus-ctd-template text="ไฟล์การชำระเงินจะถูกสร้างขึ้นในรูปแบบ MT101 และถูกส่งไปยังธนาคาร BNP ซึ่งยอมรับไฟล์การชำระเงิน"/>
                    <focus-ctd-template text="## Combinatorial Test Plan"/>
