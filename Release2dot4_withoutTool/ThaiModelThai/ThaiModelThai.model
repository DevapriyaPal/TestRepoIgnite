    <focus-ctd-decoration decorationName="DefaultStructuredDecoration" decorationType="structuredDecoration" isActiveDecoration="true">
        <focus-ctd-trigger appliance="ALWAYS" is_or="false" name="test case id-1" negative="false" suppressNewLine="false" triggerType="TEST_CASE_ID">
            <focus-ctd-single-template>
                <focus-ctd-template text="TC1"/>
            </focus-ctd-single-template>
        </focus-ctd-trigger>
        <focus-ctd-trigger appliance="ALWAYS" is_or="false" name="test data-1" negative="false" suppressNewLine="false" triggerType="Test_Data">
            <focus-ctd-single-template>
                <focus-ctd-template text="ใบแจ้งหนี้ที่มีสกุลเงินเป็น USD และซัพพลายเออร์มีสิทธิ์ได้รับชำระเงินเป็นสกุลเงินแข็งจากรัฐบาล&#10;แบบฟอร์ม PO ที่กำหนดค่าให้สอดคล้องกับเทมเพลตการกำหนดค่ามาตรฐาน&#10;ใบแจ้งหนี้ที่มีภาษีสองประเภทที่แตกต่างกัน&#10;ไฟล์การชำระเงินในรูปแบบ MT101&#10;### Steps to Reproduce:&#10;ส่งใบแจ้งหนี้จากพอร์ทัลรัฐบาลอียิปต์ผ่าน edicom ไปยัง Basware&#10;ตรวจสอบว่าสกุลเงินในใบแจ้งหนี้เป็น USD และซัพพลายเออร์มีสิทธิ์ได้รับชำระเงินเป็นสกุลเงินแข็งจากรัฐบาล&#10;ผู้ใช้ทางธุรกิจขออนุมัติการชำระเงินและขอให้แคชเชียร์จ่ายเงินสด&#10;แคชเชียร์จ่ายเงินสดและขอให้ RTR บันทึกรายการบันทึกบัญชีเงินสด&#10;ตรวจสอบยอดคงเหลือในบัญชีพักชำระหนี้กับใบแจ้งหนี้ที่ลงรายการไว้&#10;ทีม PTP เคลียร์ยอดคงเหลือกับใบแจ้งหนี้ของซัพพลายเออร์&#10;ตรวจสอบว่าแบบฟอร์ม PO ถูกสร้างขึ้นในรูปแบบที่ถูกต้อง&#10;ตรวจสอบว่าภาษีสองประเภทที่แตกต่างกันถูกประมวลผลสำเร็จ&#10;สร้างไฟล์การชำระเงินในรูปแบบ MT101 และส่งไปยังธนาคาร Credit Agricole&#10;ตรวจสอบว่าธนาคารยอมรับไฟล์การชำระเงิน&#10;### Actual Result:&#10;To be filled after test execution."/>
            </focus-ctd-single-template>
        </focus-ctd-trigger>
        <focus-ctd-trigger appliance="ALWAYS" is_or="false" name="test case id-2" negative="false" suppressNewLine="false" triggerType="TEST_CASE_ID">
